<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mono_bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/mono_text"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading, voice and app preferences"
            android:textColor="@color/mono_muted"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READING"
            android:textColor="@color/mono_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_font">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_type"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Font Size"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Text size in the reader"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_font_minus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Decrease" />

            <TextView
                android:id="@+id/tv_font_value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Medium"
                android:textColor="@color/mono_text"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btn_font_plus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Increase" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_line">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_rows"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Line Spacing"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Space between lines"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_ls_minus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Decrease" />

            <TextView
                android:id="@+id/tv_ls_value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Normal"
                android:textColor="@color/mono_text"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btn_ls_plus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Increase" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_awake">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_sun"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keep Screen Awake"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Screen stays on while reading"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_awake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_remember">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_map_pin"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Remember Reading Position"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reopen PDFs where you left off"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_remember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_autosave">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_save"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-save Progress"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save position continuously"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_autosave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOICE"
            android:textColor="@color/mono_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:id="@+id/row_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/mono_muted"
                android:contentDescription="Voice" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_voice_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System default"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron"
                app:tint="@color/mono_muted"
                android:contentDescription="Change" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_speed">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_gauge"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Speech Speed"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Playback rate for voice"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_speed_minus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Decrease" />

            <TextView
                android:id="@+id/tv_speed_value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="@color/mono_text"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btn_speed_plus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Increase" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_pitch">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tuning"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pitch"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice pitch (engine dependent)"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_pitch_minus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Decrease" />

            <TextView
                android:id="@+id/tv_pitch_value"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1.0"
                android:textColor="@color/mono_text"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btn_pitch_plus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                app:tint="@color/mono_text2"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Increase" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_auto_next">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_skip_fwd"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-read Next Page"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continue speaking across pages"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_auto_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_voice_on">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_volume"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice Enabled"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show and use voice reading"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_voice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIBRARY"
            android:textColor="@color/mono_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_confirm">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirm Before Delete"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ask before removing a PDF"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <LinearLayout
            android:id="@+id/row_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_eraser"
                app:tint="@color/mono_muted"
                android:contentDescription="Clear" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear Reading Progress"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_lib_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stored locally on this device"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP BEHAVIOR"
            android:textColor="@color/mono_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:paddingVertical="10dp"
            android:id="@+id/row_open_last">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_book_open"
                app:tint="@color/mono_muted"
                android:contentDescription="Setting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open Last Read PDF"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resume last document on launch"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_open_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/switch_thumb_mono"
                app:trackTint="@color/switch_track_mono" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textColor="@color/mono_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_info"
                app:tint="@color/mono_muted"
                android:contentDescription="About" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tv_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mute"
                    android:textColor="@color/mono_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0"
                    android:textColor="@color/mono_muted"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Created by Tobi"
            android:textColor="@color/mono_text2"
            android:textSize="12.5sp"
            android:layout_marginStart="46dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Built with care by Tobi."
            android:textColor="@color/mono_muted"
            android:textSize="11sp"
            android:layout_marginStart="46dp"
            android:layout_marginTop="2dp" />
        <TextView
            android:id="@+id/row_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Settings"
            android:textColor="@color/mono_text2"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="14dp"
            android:layout_marginTop="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mono_border"
            android:layout_marginStart="46dp" />
    </LinearLayout>
</ScrollView>
